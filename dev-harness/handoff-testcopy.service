[Unit]
Description=Ironwood Handoff test copy (sample data, nothing sent to Zoho) on port 5050
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/devserver/Projects/ironwood-handoff-app
ExecStart=/home/devserver/.nvm/versions/node/v24.15.0/bin/node /home/devserver/Projects/ironwood-handoff-app/dev-harness/serve.js
Environment=PORT=5050 HOST=0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
