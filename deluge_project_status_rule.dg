// =====================================
// set_project_in_progress  (Zoho PROJECTS task custom function)
//
// Setup: Projects > Settings > Marketplace > Custom Functions > Tasks >
// Create Custom Function. Arguments: portalId = Portal ID, projectId = Project ID.
// Paste everything BELOW the comment block (the editor writes the first line).
// Then Task Automation > Workflow Rules: the rule that fires when a task is
// completed runs this function (Associate Custom Function).
//
// THE RULES (run on every task update):
//   - Active, a task completed and others still open  -> In Progress.
//   - Active or In Progress, every task completed      -> Completed (added 2026-10-23).
//   - Any other status (On Hold, Delayed, Invoiced, Cancelled, set by hand) stays.
//   - A reopened task does not move a project back; that stays a person's call.
//
// WHY THE OCT 8 VERSION NEVER WORKED: GET /module/projects/status/ returns a
// bare list, not a "project_custom_status" object, and the names in it are
// keys such as zp.projstatus.inprogress, not "In Progress". It stopped at the
// first check on every run. The live rule ran Zoho's gallery function instead,
// which sets the status to the task list's name; no list is named after a status.
//
// In Progress is status id 1768463000000020092 in this portal (read from the
// API 2026-10-22, key zp.projstatus.inprogress). POST custom_status=<id> on
// /projects/{id}/ was tested the same day: Active -> In Progress -> Active.
// The project's own custom_status_name reads "Active" / "In Progress".
// =====================================
string set_project_in_progress(long portalId, long projectId)
{
projResp = invokeurl
[
	url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + projectId + "/"
	type :GET
	connection:"connectionprojects"
];
projList = projResp.get("projects");
if(projList == null || projList.size() == 0)
{
	return "No project returned: " + projResp.toString();
}
proj = projList.get(0);
statusName = ifnull(proj.get("custom_status_name"),"").trim();
closedCount = 0;
openCount = 0;
counts = proj.get("task_count");
if(counts != null)
{
	closedCount = ifnull(counts.get("closed"),0).toString().toLong();
	openCount = ifnull(counts.get("open"),0).toString().toLong();
}
// Active or In Progress only. On Hold, Delayed, Invoiced, Cancelled or any
// status set by hand stays as it is.
isActive = statusName.equalsIgnoreCase("Active");
isInProgress = statusName.equalsIgnoreCase("In Progress");
if(!isActive && !isInProgress)
{
	return "Left alone: status is " + statusName + ".";
}
// Every task done: Completed (id 1768463000000020116, zp.projstatus.completed).
// Work started and still open: In Progress (id 1768463000000020092).
wantedId = "";
wantedName = "";
if(closedCount >= 1 && openCount == 0)
{
	wantedId = "1768463000000020116";
	wantedName = "Completed";
}
else if(closedCount >= 1 && openCount >= 1 && isActive)
{
	wantedId = "1768463000000020092";
	wantedName = "In Progress";
}
if(wantedId == "")
{
	return "Left alone: " + statusName + ", closed=" + closedCount + " open=" + openCount + ".";
}
updParams = Map();
updParams.put("custom_status",wantedId);
updResp = invokeurl
[
	url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + projectId + "/"
	type :POST
	parameters:updParams
	connection:"connectionprojects"
];
return "Set " + wantedName + " (closed=" + closedCount + " open=" + openCount + "): " + updResp.toString();
}
