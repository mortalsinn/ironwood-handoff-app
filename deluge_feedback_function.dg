string standalone.submit_handoff_feedback(String dealId, String body)
{
// !! DEPLOYMENT: after saving this function, its REST API must be switched on
// or the widget gets {"code":"NOT_ACTIVE","message":"api is inactive for the
// given custom function"} and nothing runs. Functions list > Settings for this
// function > REST API > enable the OAuth 2.0 slider > Save. create_handoff_tasks
// already has it on, which is why that one worked and this one silently did not.
// =====================================
// HANDOFF FEEDBACK -> NOTE ON THE DEAL
// The report is written as a NOTE on the deal it came from. That is where
// someone looking for it would look, and it is the one CRM write this
// codebase has proven works - the project link note has been landing since
// 2026-08-07. A CRM Task is also attempted as something to tick off, but it
// is NOT the record of truth: an earlier version relied on the task alone,
// reported success, and the report was nowhere to be found.
//
// The widget sends the message plus a context block it gathered itself -
// app version, deal, and every answer that was on screen - so a report can
// be reproduced without the reporter typing it all out.
// =====================================
info "Feedback received. Deal: " + dealId;
if(body == null || body.trim() == "")
{
	return "Error: empty feedback body.";
}
// First line of the message becomes the subject, so the Activities list is
// readable without opening anything. Trimmed to keep the list tidy.
firstLine = body;
if(body.indexOf("\n") > 0)
{
	firstLine = body.subString(0,body.indexOf("\n"));
}
if(firstLine.length() > 70)
{
	firstLine = firstLine.subString(0,70) + "...";
}
// A NOTE ON THE DEAL FIRST, ALWAYS.
// The first version created a CRM Task related to the deal via What_Id and
// $se_module, and reported success - but the task did not appear in the
// deal's Open Activities. Rather than keep guessing at how Deluge relates a
// task to a deal, the report is written as a NOTE, which is the one CRM write
// this codebase has already proven works (the project link note).
// A note sits on the deal record where it was reported from, which is also
// the easiest place to find it.
noteSaved = "no";
if(dealId != null && dealId != "")
{
	noteData = Map();
	noteData.put("Parent_Id",dealId);
	noteData.put("se_module","Deals");
	noteData.put("Note_Title","[Handoff Feedback] " + firstLine);
	noteData.put("Note_Content",body);
	noteResponse = zoho.crm.createRecord("Notes",noteData);
	info "FEEDBACK NOTE RESULT: " + noteResponse.toString();
	if(noteResponse.get("id") != null)
	{
		noteSaved = "yes";
	}
}
// The task is a convenience on top - something to tick off - not the record
// of truth. If it fails, or lands somewhere unexpected, the note still has it.
taskSaved = "no";
taskData = Map();
taskData.put("Subject","[Handoff Feedback] " + firstLine);
taskData.put("Status","Not Started");
taskData.put("Priority","High");
taskData.put("Description",body);
if(dealId != null && dealId != "")
{
	taskData.put("What_Id",dealId);
	taskData.put("$se_module","Deals");
}
taskResponse = zoho.crm.createRecord("Tasks",taskData);
info "FEEDBACK TASK RESULT: " + taskResponse.toString();
if(taskResponse.get("id") != null)
{
	taskSaved = "yes";
}
// ---- CLIQ PING, DISABLED UNTIL THE CONNECTION EXISTS ----
// Deluge validates connection names when the function is SAVED, not when it
// runs, so leaving this live would stop the whole function saving with
// "connection 'cliq_connection' does not exist". Same trap as the zcrm route
// in the handoff function.
// TO ENABLE:
//   1. Setup > Developer Space > Connections > Create Connection
//      Service: Zoho Cliq   Link name: cliq_connection
//      Tick the Cliq scopes the picker offers, authorise it.
//   2. Put the recipient's ZOHO ORG email in cliqTo below (not a personal one).
//   3. Uncomment the block.
// Fail-open on purpose: the note is the record of truth, and a chat ping that
// fails must never cost us the report.
// cliqTo = "someone@ironwoodstairs.com";
// try
// {
// cliqMsg = "*Handoff feedback*\n" + firstLine + "\n\nDeal id: " + dealId;
// cliqRes = zoho.cliq.postToUser(cliqTo,cliqMsg,"cliq_connection");
// info "FEEDBACK CLIQ RESULT: " + cliqRes.toString();
// }
// catch (e)
// {
// info "FEEDBACK CLIQ FAILED: " + e.toString();
// }
// Say exactly where it went. The widget prints this back, because the CRM
// function log does not retain info statements - a call that quietly does
// nothing looks identical to one that worked.
if(noteSaved == "yes" && taskSaved == "yes")
{
	return "Success: saved as a NOTE on the deal, and as a task. Deal id " + dealId;
}
if(noteSaved == "yes")
{
	return "Success: saved as a NOTE on the deal. Deal id " + dealId;
}
if(taskSaved == "yes")
{
	return "Success: saved as a task (no deal attached). Subject starts [Handoff Feedback].";
}
return "Error: could not save feedback anywhere. Task said: " + taskResponse.toString();

}
