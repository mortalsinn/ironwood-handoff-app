string standalone.submit_handoff_feedback(String dealId, String body)
{
// !! DEPLOYMENT: after saving this function, its REST API must be switched on
// or the widget gets {"code":"NOT_ACTIVE","message":"api is inactive for the
// given custom function"} and nothing runs. Functions list > Settings for this
// function > REST API > enable the OAuth 2.0 slider > Save. create_handoff_tasks
// already has it on, which is why that one worked and this one silently did not.
// =====================================
// HANDOFF FEEDBACK -> CRM TASK ON THE DEAL
// A report lands as a Task against the deal it came from, so it shows in the
// deal's Open Activities: a list you work through and close, rather than
// another note to scroll past.
//
// A Note is kept ONLY as a fallback for when the task cannot be created. It
// was briefly the primary destination, on my incorrect conclusion that tasks
// do not attach to a deal - in fact the function had never run at all, its
// REST API was off. Tasks attach fine.
//
// The widget sends the message plus a context block it gathers itself - app
// version, deal, and every answer that was on screen - so a report can be
// reproduced without the reporter typing it all out.
// =====================================
info "Feedback received. Deal: " + dealId;
if(body == null || body.trim() == "")
{
	return "Error: empty feedback body.";
}
// First line of the message becomes the subject, so Open Activities is
// readable without opening anything. Trimmed to keep the list tidy.
firstLine = body;
if(body.indexOf("\n") > 0)
{
	firstLine = body.subString(0,body.indexOf("\n"));
}
if(firstLine.length() > 70)
{
	firstLine = firstLine.subString(0,70) + "...";
}
taskData = Map();
taskData.put("Subject","[Handoff Feedback] " + firstLine);
taskData.put("Status","Not Started");
taskData.put("Priority","High");
taskData.put("Description",body);
if(dealId != null && dealId != "")
{
	taskData.put("What_Id",dealId);
	taskData.put("$se_module","Deals");
}
taskResponse = zoho.crm.createRecord("Tasks",taskData);
info "FEEDBACK TASK RESULT: " + taskResponse.toString();
if(taskResponse.get("id") != null)
{
	// ---- CLIQ PING, DISABLED UNTIL THE CONNECTION EXISTS ----
	// Deluge validates connection names when the function is SAVED, not when it
	// runs, so leaving this live would stop the whole function saving with
	// "connection 'cliq_connection' does not exist". Same trap as the zcrm route
	// in the handoff function.
	// TO ENABLE:
	//   1. Setup > Developer Space > Connections > Create Connection
	//      Service: Zoho Cliq   Link name: cliq_connection
	//      Tick the Cliq scopes the picker offers, authorise it.
	//   2. Put the recipient's ZOHO ORG email in cliqTo below (not a personal one).
	//   3. Uncomment the block.
	// Fail-open on purpose: the task is the record of truth, and a chat ping
	// that fails must never cost us the report.
	// cliqTo = "someone@ironwoodstairs.com";
	// try
	// {
	// cliqMsg = "*Handoff feedback*\n" + firstLine + "\n\nDeal id: " + dealId;
	// cliqRes = zoho.cliq.postToUser(cliqTo,cliqMsg,"cliq_connection");
	// info "FEEDBACK CLIQ RESULT: " + cliqRes.toString();
	// }
	// catch (e)
	// {
	// info "FEEDBACK CLIQ FAILED: " + e.toString();
	// }
	return "Success: logged under Open Activities on the deal.";
}
// FALLBACK ONLY. Losing a report someone took the trouble to type is the worst
// outcome here, so if the task will not save, put it somewhere.
if(dealId != null && dealId != "")
{
	noteData = Map();
	noteData.put("Parent_Id",dealId);
	noteData.put("se_module","Deals");
	noteData.put("Note_Title","[Handoff Feedback] " + firstLine);
	noteData.put("Note_Content",body);
	noteResponse = zoho.crm.createRecord("Notes",noteData);
	info "FEEDBACK NOTE FALLBACK: " + noteResponse.toString();
	if(noteResponse.get("id") != null)
	{
		return "Success: the task failed, so it is saved as a NOTE on the deal instead.";
	}
}
return "Error: could not save feedback anywhere. Task said: " + taskResponse.toString();
}
