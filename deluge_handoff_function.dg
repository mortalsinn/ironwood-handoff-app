string standalone.create_handoff_tasks(String dealId,String payload)
{
payloadData = payload.toMap();
info "Handoff Triggered for Deal ID: " + dealId;
info "Payload: " + payloadData;
dealInfo = zoho.crm.getRecordById("Deals",dealId.toLong());
dealName = dealInfo.get("Deal_Name");
projectName = dealName + " - Production";
portalId = "ironwoodstairs";
// =====================================
// IDEMPOTENCY GUARD: RE-USE AN EXISTING PROJECT IF ONE MATCHES
// A retried or double-clicked handoff must never create a duplicate
// project. If the lookup fails we fail open and create normally.
// =====================================
newProjectId = "";
isReusedProject = "no";
existingProjectsResponse = invokeurl
[
	url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/?index=1&range=200"
	type :GET
	connection:"zoho_projects_connection"
];
existingProjects = existingProjectsResponse.get("projects");
if(existingProjects != null)
{
	for each  existingProj in existingProjects
	{
		if(newProjectId == "" && existingProj.get("name") == projectName)
		{
			newProjectId = existingProj.get("id_string");
			isReusedProject = "yes";
			info "IDEMPOTENCY: Re-using existing project " + newProjectId + " (" + projectName + ")";
		}
	}
}
if(newProjectId == "")
{
	projectData = Map();
	projectData.put("name",projectName);
	projectData.put("template_id","1768463000007543025");
	projectData.put("description","Auto-generated from Ironwood Handoff Widget. Notes: " + payloadData.get("notes"));
	projectData.put("public","yes");
	// =====================================
	// INJECT PROJECT OWNER IF ASSIGNED
	// =====================================
	if(payloadData.get("project_owner") != null && payloadData.get("project_owner") != "UNASSIGNED" && payloadData.get("project_owner") != "")
	{
		projectData.put("owner",payloadData.get("project_owner"));
	}
	createResponse = zoho.projects.createProject(portalId,projectData,"zoho_projects_connection");
	if(createResponse.get("projects") == null)
	{
		return "Error creating project in Zoho: " + createResponse.toString();
	}
	newProjectId = createResponse.get("projects").get(0).get("id_string");
	// =====================================
	// LINK THE PROJECT BACK TO THE DEAL
	// A project created through the REST API is never associated with the CRM
	// Deal, so the Deal's "Zoho Projects" related list stays empty. Drop a note
	// on the Deal carrying a direct link so the project is at least reachable.
	// Sits inside the creation branch on purpose: a retried handoff re-uses the
	// existing project and must not stack duplicate notes.
	// Fail-open - a failed note must never turn a completed handoff into a
	// Warning, so nothing here is added to failedItems.
	// =====================================
	// The URL needs the portal's default task-view id or it lands on the list of
	// ALL projects instead of this one. That id is portal-level, not per-project:
	// confirmed identical across two different projects on 2026-08-07
	// (...7756008 and ...7787094 both carry ...3199003). Ending on /gantt so the link
	// opens the schedule the handoff just built.
	// Built by hand rather than read from the create response - that response
	// carries no usable url field, confirmed on the first live run.
	taskViewId = "1768463000003199003";
	projectUrl = "https://projects.zoho.com/portal/" + portalId + "#zp/projects/" + newProjectId + "/tasks/custom-view/" + taskViewId + "/gantt?group_by=none";
	linkNote = Map();
	linkNote.put("Parent_Id",dealId);
	linkNote.put("se_module","Deals");
	linkNote.put("Note_Title","Zoho Project - " + projectName);
	// Content is the bare URL and nothing else. Two reasons, both observed live
	// on 2026-08-07: Deluge did not interpret the newline escape here, writing
	// it into the note as two literal characters glued to the front of the URL,
	// and CRM Note bodies are plain text so no markdown or link syntax renders -
	// the widget's own user mentions come out raw in the same way. A clean
	// unadorned URL is the only form with a chance of auto-linking, and the note
	// title already says what it is.
	linkNote.put("Note_Content",projectUrl);
	// Attribute the note to the Deal owner. Without this the note shows whoever
	// this standalone function executes as - a fixed CRM user unrelated to the
	// job (it read "Mike Kent" on every note regardless of who ran the handoff).
	// CONFIRMED WORKING 2026-08-07: setting Owner does change the byline in the
	// Notes UI, so no need to move this into the widget. Guarded - a Deal with no
	// Owner still gets its note, just attributed as before.
	dealOwnerInfo = dealInfo.get("Owner");
	if(dealOwnerInfo != null)
	{
		dealOwnerId = dealOwnerInfo.get("id");
		if(dealOwnerId != null)
		{
			linkNote.put("Owner",dealOwnerId);
			info "DEAL LINK NOTE OWNER: " + dealOwnerId;
		}
	}
	linkNoteResponse = zoho.crm.createRecord("Notes",linkNote);
	info "DEAL LINK NOTE RESULT: " + linkNoteResponse.toString();
	// =====================================
	// POPULATE THE DEAL'S "ZOHO PROJECTS" RELATED LIST
	// The note above is a fallback and stays. This is the real association, so
	// the project appears under the Deal's Zoho Projects sub-menu the way a
	// project created from inside CRM does.
	// Two routes are tried because only the second is confirmed by anyone
	// publicly, and the first needs no new connection:
	//   1. zoho.crm.updateRelatedRecord - native, runs on this function's own
	//      CRM scope. Cross-application (Projects) support is NOT documented,
	//      so it may simply fail, which is why route 2 follows it.
	//   2. POST /crm/v2/Deals/{dealId}/Zoho_Projects/{projectId} - this is the
	//      endpoint the CRM UI itself uses. It needs a connection with CRM
	//      scope named "zcrm"; if that connection does not exist the call
	//      throws, which the try/catch swallows.
	// BOTH ARE FAIL-OPEN. A failure here must never turn a completed handoff
	// into a Warning, so nothing is added to failedItems and nothing returns
	// early. Read the execution log lines below to see which route worked.
	// UNVERIFIED: written from Zoho's docs and a community thread, never yet
	// run against the live portal.
	// =====================================
	try
	{
		linkValues = Map();
		linkValues.put("name",projectName);
		assocNative = zoho.crm.updateRelatedRecord("Zoho_Projects",newProjectId,"Deals",dealId,linkValues);
		info "DEAL PROJECT ASSOC (native): " + assocNative.toString();
	}
	catch (e)
	{
		info "DEAL PROJECT ASSOC (native) FAILED: " + e.toString();
	}
	try
	{
		assocRow = Map();
		assocRow.put("name",projectName);
		dealRef = Map();
		dealRef.put("id",dealId);
		assocRow.put("deals",{dealRef});
		assocBody = Map();
		assocBody.put("data",{assocRow});
		assocRest = invokeurl
		[
			url :"https://www.zohoapis.com/crm/v2/Deals/" + dealId + "/Zoho_Projects/" + newProjectId
			type :POST
			parameters:assocBody.toString()
			connection:"zcrm"
		];
		info "DEAL PROJECT ASSOC (rest): " + assocRest.toString();
	}
	catch (e)
	{
		info "DEAL PROJECT ASSOC (rest) FAILED: " + e.toString();
	}
}
if(newProjectId == null)
{
	newProjectId = "";
}
if(newProjectId == "")
{
	return "Error: Could not create Zoho Project.";
}
taskListsMap = payloadData.get("task_lists");
if(taskListsMap == null)
{
	return "Success: Project created in Zoho Projects (no tasks in payload).";
}
// =====================================
// USERS: EXTRACT UNIQUE ASSIGNEES & INVITE
// ID-based invite first; the e-mail invite only fires as a fallback
// when the ID attempt fails (halves the API calls in the common case
// while keeping the fix for API error 6831).
// =====================================
uniqueUsers = List();
userEmailsMap = Map();
for each  listName in taskListsMap.keys()
{
	tasksInList = taskListsMap.get(listName);
	if(tasksInList != null)
	{
		for each  taskObj in tasksInList
		{
			uid = taskObj.get("person_responsible");
			email = taskObj.get("zuid");
			if(uid != "" && uid != null && !uniqueUsers.contains(uid))
			{
				uniqueUsers.add(uid);
				if(email != null && email != "")
				{
					userEmailsMap.put(uid,email);
				}
			}
		}
	}
}
for each  uid in uniqueUsers
{
	addUsersResponse = invokeurl
	[
		url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + newProjectId + "/users/?users_list=" + uid + "&role=employee"
		type :POST
		connection:"zoho_projects_connection"
	];
	info "ADD USER BY ID (" + uid + ") RESULT: " + addUsersResponse.toString();
	if(addUsersResponse.get("users") == null)
	{
		email = userEmailsMap.get(uid);
		if(email != null && email != "")
		{
			addUserEmailParams = Map();
			addUserEmailParams.put("email",email);
			addUserEmailParams.put("role","employee");
			addUsersEmailResponse = invokeurl
			[
				url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + newProjectId + "/users/"
				type :POST
				parameters:addUserEmailParams
				connection:"zoho_projects_connection"
			];
			info "ADD USER BY EMAIL (" + email + ") RESULT: " + addUsersEmailResponse.toString();
		}
	}
}
// =====================================
// TASK LIST READINESS POLL
// Replaces the old postman-echo delay: template task lists provision
// asynchronously right after project creation, so poll the real
// endpoint - each round trip both waits and confirms readiness.
// (Deluge has no break; the listsReady flag skips finished attempts.)
// =====================================
existingListsMap = Map();
listsReady = "no";
pollAttempts = "1,2,3,4,5".toList(",");
for each  attempt in pollAttempts
{
	if(listsReady == "no")
	{
		existingListsResponse = invokeurl
		[
			url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + newProjectId + "/tasklists/"
			type :GET
			connection:"zoho_projects_connection"
		];
		existingTaskLists = existingListsResponse.get("tasklists");
		if(existingTaskLists != null && existingTaskLists.size() > 0)
		{
			for each  elist in existingTaskLists
			{
				existingListsMap.put(elist.get("name"),elist.get("id_string"));
			}
			listsReady = "yes";
		}
	}
}
if(listsReady == "no")
{
	info "READINESS: task lists still not provisioned after polling; proceeding with fresh list creation.";
}
// =====================================
// EXISTING TASK NAMES
// Lets a retried handoff skip tasks that already made it in,
// instead of duplicating them.
// =====================================
existingTaskNames = List();
existingTaskIdsMap = Map();
existingTasksResponse = invokeurl
[
	url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + newProjectId + "/tasks/?index=1&range=200"
	type :GET
	connection:"zoho_projects_connection"
];
existingTasks = existingTasksResponse.get("tasks");
if(existingTasks != null)
{
	for each  existingTask in existingTasks
	{
		existingTaskNames.add(existingTask.get("name"));
		existingTaskIdsMap.put(existingTask.get("name"),existingTask.get("id_string"));
	}
}
// =====================================
// CREATE TASK LISTS & TASKS
// Every failure is collected so the widget can show an honest result
// instead of a false success.
// =====================================
failedItems = List();
skippedCount = 0;
createdCount = 0;
keys = taskListsMap.keys();
for each  listName in keys
{
	tasksInList = taskListsMap.get(listName);
	if(tasksInList != null && tasksInList.size() > 0)
	{
		createdTaskListId = existingListsMap.get(listName);
		if(createdTaskListId == null)
		{
			taskListParams = Map();
			taskListParams.put("name",listName);
			taskListResponse = invokeurl
			[
				url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + newProjectId + "/tasklists/"
				type :POST
				parameters:taskListParams
				connection:"zoho_projects_connection"
			];
			if(taskListResponse.get("tasklists") != null)
			{
				createdTaskListId = taskListResponse.get("tasklists").get(0).get("id_string");
				existingListsMap.put(listName,createdTaskListId);
			}
		}
		if(createdTaskListId == null)
		{
			info "FAILED TO CREATE TASK LIST: " + listName;
			for each  taskObj in tasksInList
			{
				failedItems.add(taskObj.get("name") + " (list '" + listName + "' could not be created)");
			}
		}
		else
		{
			taskUrl = "https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + newProjectId + "/tasks/";
			prevTaskId = "";
			prevChainGroup = -999;
			for each  taskObj in tasksInList
			{
				taskName = taskObj.get("name");
				thisTaskId = "";
				if(existingTaskNames.contains(taskName))
				{
					skippedCount = skippedCount + 1;
					info "SKIPPED (already exists): " + taskName;
					if(existingTaskIdsMap.get(taskName) != null)
					{
						thisTaskId = existingTaskIdsMap.get(taskName);
					}
				}
				else
				{
					taskParams = Map();
					taskParams.put("name",taskName);
					if(taskObj.get("person_responsible") != "" && taskObj.get("person_responsible") != null)
					{
						taskParams.put("person_responsible",taskObj.get("person_responsible"));
					}
					// =====================================
					// TIMELINE: working-day schedule computed by the widget
					// (MM-dd-yyyy). Drives the Gantt in Zoho Projects.
					// =====================================
					if(taskObj.get("start_date") != null && taskObj.get("start_date") != "")
					{
						taskParams.put("start_date",taskObj.get("start_date"));
					}
					if(taskObj.get("end_date") != null && taskObj.get("end_date") != "")
					{
						taskParams.put("end_date",taskObj.get("end_date"));
					}
					taskParams.put("tasklist_id",createdTaskListId);
					taskResponse = invokeurl
					[
						url :taskUrl
						type :POST
						parameters:taskParams
						connection:"zoho_projects_connection"
					];
					if(taskResponse.get("tasks") == null)
					{
						info "FAILED TO CREATE TASK: " + taskName + " | ERROR: " + taskResponse.toString();
						failedItems.add(taskName);
					}
					else
					{
						createdCount = createdCount + 1;
						thisTaskId = taskResponse.get("tasks").get(0).get("id_string");
					}
				}
				// =====================================
				// DEPENDENCIES: chain section boundaries (finish-to-start).
				// chain_group marks the widget section each task came from;
				// when it changes, the new section waits on the previous one.
				// Fail-open: a failed dependency call never fails the handoff.
				// =====================================
				thisChainGroup = -999;
				if(taskObj.get("chain_group") != null)
				{
					thisChainGroup = taskObj.get("chain_group");
				}
				if(thisTaskId != "")
				{
					if(prevTaskId != "" && thisChainGroup != -999 && prevChainGroup != -999 && thisChainGroup != prevChainGroup)
					{
						depParams = Map();
						depParams.put("predecessor_ids",prevTaskId);
						depResponse = invokeurl
						[
							url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + newProjectId + "/tasks/" + thisTaskId + "/"
							type :POST
							parameters:depParams
							connection:"zoho_projects_connection"
						];
						info "DEPENDENCY UPDATE (" + prevTaskId + " -> " + thisTaskId + ") RESULT: " + depResponse.toString();
						if(depResponse.get("tasks") == null)
						{
							depAltParams = Map();
							depAltParams.put("predecessor_ids",prevTaskId);
							depAltResponse = invokeurl
							[
								url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + newProjectId + "/tasks/" + thisTaskId + "/dependency/"
								type :POST
								parameters:depAltParams
								connection:"zoho_projects_connection"
							];
							info "DEPENDENCY ALT (" + prevTaskId + " -> " + thisTaskId + ") RESULT: " + depAltResponse.toString();
						}
					}
					prevTaskId = thisTaskId;
					prevChainGroup = thisChainGroup;
				}
			}
		}
	}
}
// =====================================
// HONEST RESULT
// The widget parses these prefixes: "Error" -> failure overlay,
// "Warning" -> incomplete overlay (retry fills the gaps), else success.
// =====================================
if(failedItems.size() > 0)
{
	failedNames = "";
	for each  failedItem in failedItems
	{
		if(failedNames == "")
		{
			failedNames = failedItem;
		}
		else
		{
			failedNames = failedNames + "; " + failedItem;
		}
	}
	return "Warning: The project is in Zoho Projects, but " + failedItems.size() + " task(s) could not be created: " + failedNames + ".";
}
if(isReusedProject == "yes")
{
	return "Success: Existing project updated in Zoho Projects (" + createdCount + " task(s) created, " + skippedCount + " already existed).";
}
return "Success: Project and Tasks created in Zoho Projects.";
}
